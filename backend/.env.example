APP_NAME=FreeOui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=freeoui_db
DB_USERNAME=freeoui_user
DB_PASSWORD=freeoui_password_2024

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=freeoui_redis_2024
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@freeoui.tn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=freeoui_minio
AWS_SECRET_ACCESS_KEY=freeoui_minio_password_2024
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=freeoui
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_TTL=60
JWT_REFRESH_TTL=43200
JWT_ALGO=RS256

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id

# SMS Gateway (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+21612345678

# Maps
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Payment Gateways
D17_API_KEY=
FLOUCI_APP_TOKEN=
KONNECT_API_KEY=

# QR Code Security
QR_SECRET_KEY=your_qr_secret_key_change_in_production

# Analytics
MIXPANEL_TOKEN=
SENTRY_LARAVEL_DSN=

# Feature Flags
FEATURE_PROXIMITY_ALERTS=true
FEATURE_REVIEWS=true
FEATURE_REFERRAL_PROGRAM=false
FEATURE_AI_RECOMMENDATIONS=false
