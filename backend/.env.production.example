# FreeOui Production Environment Configuration

# Application
APP_NAME=FreeOui
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.freeoui.tn

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=freeoui_production
DB_USERNAME=freeoui_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# Cache & Session
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@freeoui.tn
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=freeoui-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# Firebase Cloud Messaging
FCM_SERVER_KEY=

# Payment Providers - D17
D17_API_URL=https://api.d17.tn
D17_API_KEY=
D17_API_SECRET=

# Payment Providers - Flouci
FLOUCI_API_URL=https://developers.flouci.com/api
FLOUCI_APP_TOKEN=
FLOUCI_APP_SECRET=

# Payment Providers - Paymee
PAYMEE_API_URL=https://api.paymee.tn
PAYMEE_API_KEY=
PAYMEE_VENDOR_ID=

# Pusher (for WebSocket/real-time)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Nominatim (OpenStreetMap)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Rate Limiting
THROTTLE_LIMIT=60

# Security
SANCTUM_STATEFUL_DOMAINS=freeoui.tn,www.freeoui.tn

# CORS
CORS_ALLOWED_ORIGINS=https://freeoui.tn,https://www.freeoui.tn,https://admin.freeoui.tn

# Backups
BACKUP_RETENTION_DAYS=30

# Monitoring
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=FreeOui-Production
