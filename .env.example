# Application
APP_NAME=FreeOui
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database (PostgreSQL + PostGIS)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=freeoui_db
DB_USERNAME=freeoui_user
DB_PASSWORD=freeoui_password_2024

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=freeoui_redis_2024
REDIS_PORT=6379

# MinIO (S3-compatible)
AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=freeoui_minio
AWS_SECRET_ACCESS_KEY=freeoui_minio_password_2024
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=freeoui
AWS_USE_PATH_STYLE_ENDPOINT=true

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=your_fcm_sender_id_here

# SMS Gateway (Twilio/Nexmo)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+21612345678

# Maps API
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Payment Gateways
D17_API_KEY=your_d17_api_key
FLOUCI_APP_TOKEN=your_flouci_app_token
KONNECT_API_KEY=your_konnect_api_key

# QR Code Security
QR_SECRET_KEY=your_qr_code_secret_key_here

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_TTL=60
JWT_REFRESH_TTL=43200

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@freeoui.tn
MAIL_FROM_NAME="${APP_NAME}"

# Analytics
MIXPANEL_TOKEN=your_mixpanel_token
SENTRY_LARAVEL_DSN=your_sentry_dsn

# Feature Flags
FEATURE_PROXIMITY_ALERTS=true
FEATURE_REVIEWS=true
FEATURE_REFERRAL_PROGRAM=false
FEATURE_AI_RECOMMENDATIONS=false
